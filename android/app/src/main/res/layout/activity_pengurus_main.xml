<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefreshPengurus"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="40dp">

            <!-- Top Header Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/surface_container"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/surface_container_lowest">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Top Action Icons Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Panel Manajemen Pengurus"
                                android:textColor="@color/primary"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvPengurusGreeting"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="Misdinar SPMR Purbowardayan"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- Switch to Anggota View -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnViewAsAnggota"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:text="Mode Anggota"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary"
                            app:cornerRadius="10dp" />

                        <!-- Theme Toggle Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPengurusTheme"
                            style="@style/Widget.Material3.Button.IconButton"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="8dp"
                            android:padding="0dp"
                            android:backgroundTint="@color/surface_container_low"
                            app:strokeColor="@color/surface_container"
                            app:strokeWidth="1dp"
                            app:icon="@drawable/ic_theme_auto"
                            app:iconTint="@color/primary"
                            app:iconGravity="textStart"
                            app:cornerRadius="10dp"
                            android:contentDescription="Ganti Tema Tampilan" />

                        <!-- Logout Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPengurusLogout"
                            style="@style/Widget.Material3.Button.IconButton"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="8dp"
                            android:padding="0dp"
                            android:backgroundTint="@color/surface_container_low"
                            app:strokeColor="@color/surface_container"
                            app:strokeWidth="1dp"
                            app:icon="@drawable/ic_logout"
                            app:iconTint="@color/error"
                            app:iconGravity="textStart"
                            app:cornerRadius="10dp"
                            android:contentDescription="Keluar Akun" />
                    </LinearLayout>

                    <!-- Stat Cards Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <!-- Stat 1: Total Anggota -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/bg_card_low"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TOTAL ANGGOTA"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvStatTotalAnggota"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="-"
                                android:textColor="@color/primary"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Stat 2: Menunggu Approve -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.1"
                            android:layout_marginHorizontal="2dp"
                            android:background="@drawable/bg_badge_amber"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PERLU APPROVE"
                                android:textColor="@color/amber_800"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvStatPendingAnggota"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="-"
                                android:textColor="@color/amber_800"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Stat 3: Jadwal Aktif -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/bg_badge_gold"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="JADWAL AKTIF"
                                android:textColor="@color/secondary"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvStatActiveSchedules"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="-"
                                android:textColor="@color/secondary"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Navigation Tabs / Section Switcher matching Web -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:paddingHorizontal="16dp"
                android:paddingTop="6dp">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupPengurus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTabAnnouncements"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Warta Sakristi" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTabMembers"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Persetujuan Anggota" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTabSchedules"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jadwal &amp; Roster Misa" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTabPresensi"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Live Presensi Sakristi" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- 1. Action Bar for Announcements -->
            <LinearLayout
                android:id="@+id/layoutAnnouncementActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Daftar Pengumuman Sakristi"
                    android:textColor="@color/primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddAnnouncement"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="+ Buat Warta"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:cornerRadius="10dp"
                    android:backgroundTint="@color/primary"
                    android:textColor="@color/on_primary" />
            </LinearLayout>

            <!-- 2. Action Bar for Schedules (Generate 30 Days & Add Schedule) -->
            <LinearLayout
                android:id="@+id/layoutScheduleActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Generate 30 Hari Button matching Web -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGenerate30Days"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="⚡ Generate 30 Hari"
                        android:textColor="@color/secondary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:cornerRadius="10dp" />

                    <!-- Tambah Jadwal Manual Button matching Web -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddSchedule"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="+ Jadwal Manual"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/primary"
                        android:textColor="@color/on_primary"
                        app:cornerRadius="10dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Klik jadwal misa untuk melihat roster misdinar, mengatur peran liturgi, dan kirim pengingat WA H-1."
                    android:textColor="@color/on_surface_variant"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 3. Subfilter for Members -->
            <HorizontalScrollView
                android:id="@+id/layoutMemberFilter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:paddingHorizontal="16dp"
                android:paddingTop="8dp"
                android:visibility="gone">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupMemberFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMemberFilterPending"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Perlu Approve" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMemberFilterActive"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Anggota Aktif" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMemberFilterAll"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Semua Anggota" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- 4. Presensi Live Counters matching Web -->
            <LinearLayout
                android:id="@+id/layoutPresensiCounters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ringkasan Presensi Pekan Ini"
                    android:textColor="@color/primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <!-- Hadir -->
                    <TextView
                        android:id="@+id/tvCounterHadir"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="3dp"
                        android:background="@drawable/bg_badge_emerald"
                        android:gravity="center"
                        android:paddingVertical="6dp"
                        android:text="Hadir: 0"
                        android:textColor="@color/emerald_800"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <!-- Terlambat -->
                    <TextView
                        android:id="@+id/tvCounterTerlambat"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="3dp"
                        android:background="@drawable/bg_badge_amber"
                        android:gravity="center"
                        android:paddingVertical="6dp"
                        android:text="Terlambat: 0"
                        android:textColor="@color/amber_800"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <!-- Izin -->
                    <TextView
                        android:id="@+id/tvCounterIzin"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="3dp"
                        android:background="@drawable/bg_badge_marian"
                        android:gravity="center"
                        android:paddingVertical="6dp"
                        android:text="Izin: 0"
                        android:textColor="@color/on_primary_fixed"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <!-- Alpa -->
                    <TextView
                        android:id="@+id/tvCounterAlpa"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="3dp"
                        android:background="@drawable/bg_card_low"
                        android:gravity="center"
                        android:paddingVertical="6dp"
                        android:text="Alpa: 0"
                        android:textColor="@color/error"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Loading Spinner -->
            <ProgressBar
                android:id="@+id/progressPengurus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginVertical="24dp"
                android:visibility="gone" />

            <!-- Empty text -->
            <TextView
                android:id="@+id/tvPengurusEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="24dp"
                android:text="Data tidak ditemukan."
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Dynamic RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPengurusList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false" />

            <!-- App Version & OTA Update Check Trigger -->
            <TextView
                android:id="@+id/tvPengurusAppVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="24dp"
                android:padding="8dp"
                android:text="SiDinar Regina v1.0.0 • Cek Pembaruan"
                android:textColor="@color/on_surface_variant"
                android:textSize="11sp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
