<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefreshMb"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="36dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface_container_lowest"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMbBack"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:backgroundTint="@color/surface_container_low"
                    app:cornerRadius="10dp"
                    app:icon="@drawable/ic_close"
                    app:iconTint="@color/primary"
                    android:contentDescription="Kembali" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvMbHeaderTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Latihan Petugas Misa Besar"
                        android:textColor="@color/primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMbHeaderSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Natal, Pekan Suci &amp; Paskah SPMR"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="11sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMbInitPresets"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Setup 7 Misa"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:cornerRadius="10dp" />
            </LinearLayout>

            <!-- Loading / Migration Card -->
            <ProgressBar
                android:id="@+id/progressMb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="24dp"
                android:visibility="gone" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMbMigrationNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/amber_50"
                app:cardCornerRadius="18dp"
                app:strokeColor="@color/amber_400"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Database Modul Misa Besar Belum Aktif"
                        android:textColor="@color/amber_800"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Jalankan skrip migrasi 20261110000000_misa_besar_latihan.sql di Supabase SQL Editor (atau salin langsung dari menu Pengurus Web)."
                        android:textColor="@color/on_surface_variant"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ANGGOTA PERSONAL QR KARTU LATIHAN -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMbAnggotaQr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/primary"
                app:cardCornerRadius="22dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="KARTU QR ABSEN LATIHAN"
                        android:textColor="@color/primary_fixed"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMbMyName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Nama Anggota"
                        android:textColor="@color/on_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/ivMbMyQr"
                        android:layout_width="170dp"
                        android:layout_height="170dp"
                        android:layout_marginTop="12dp"
                        android:background="@color/surface"
                        android:padding="8dp"
                        android:contentDescription="QR Code Absen Latihan" />

                    <TextView
                        android:id="@+id/tvMbMyShortId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="ID: -"
                        android:textColor="@color/primary_fixed"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="Tunjukkan QR Code ini kepada Pengurus saat hadir latihan Misa Besar."
                        android:textColor="@color/primary_fixed_dim"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 7 PERAYAAN SELECTOR CHIPS -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingHorizontal="16dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupMbEvents"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true" />
            </HorizontalScrollView>

            <!-- PENGURUS CONTROL DECK -->
            <LinearLayout
                android:id="@+id/layoutMbPengurusControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Latihan Selector & Scan Row -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/surface_container_lowest"
                    app:cardCornerRadius="18dp"
                    app:strokeColor="@color/surface_container"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/tvMbActiveEventInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Perayaan"
                            android:textColor="@color/primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvMbActiveLatihanInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Pilih atau buat sesi latihan"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="11sp" />

                        <!-- Row: Pilih Latihan & Buat Latihan -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnMbSelectLatihan"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="0dp"
                                android:layout_height="38dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="4dp"
                                android:text="Pilih Latihan"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                app:cornerRadius="10dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnMbAddLatihan"
                                android:layout_width="wrap_content"
                                android:layout_height="38dp"
                                android:layout_marginHorizontal="4dp"
                                android:backgroundTint="@color/primary"
                                android:text="+ Latihan"
                                android:textColor="@color/on_primary"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                app:cornerRadius="10dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnMbAddPetugas"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="38dp"
                                android:layout_marginStart="4dp"
                                android:text="+ Petugas"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                app:cornerRadius="10dp" />
                        </LinearLayout>

                        <!-- Row: Scan QR & Paskah 2/3 Misa & Semua Hadir -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnMbScanQr"
                                android:layout_width="0dp"
                                android:layout_height="38dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="4dp"
                                android:backgroundTint="@color/secondary"
                                android:text="Pindai QR Latihan"
                                android:textColor="@color/on_secondary"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                app:cornerRadius="10dp"
                                app:icon="@drawable/ic_qr_code"
                                app:iconSize="16dp"
                                app:iconTint="@color/on_secondary" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnMbAllHadir"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="38dp"
                                android:layout_marginStart="4dp"
                                android:backgroundTint="@color/emerald_100"
                                android:text="Semua Hadir"
                                android:textColor="@color/emerald_800"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                app:cornerRadius="10dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnMbTogglePaskahCount"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="38dp"
                                android:layout_marginStart="4dp"
                                android:text="2/3 Misa"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:visibility="gone"
                                app:cornerRadius="10dp" />
                        </LinearLayout>

                        <!-- Stats Strip -->
                        <TextView
                            android:id="@+id/tvMbStatsStrip"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_card_low"
                            android:padding="10dp"
                            android:text="Total: 0 | Hadir: 0 | Telat: 0 | Izin: 0 | Alpa: 0 | Belum: 0"
                            android:textColor="@color/primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Filter Sessions (Misa 1, Misa 2, Ibadat 1...) -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupMbSessions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleSelection="true" />
                </HorizontalScrollView>
            </LinearLayout>

            <!-- Daftar Petugas / Penugasan -->
            <TextView
                android:id="@+id/tvMbListTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="14dp"
                android:text="Daftar Petugas &amp; Absensi Latihan"
                android:textColor="@color/primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMbEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:padding="24dp"
                android:text="Belum ada data untuk ditampilkan."
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMbPetugas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
