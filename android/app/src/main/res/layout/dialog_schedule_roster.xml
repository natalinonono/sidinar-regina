<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_card_lowest">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_church"
            app:tint="@color/primary" />

        <TextView
            android:id="@+id/tvRosterJudulMisa"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Misa Kudus"
            android:textColor="@color/primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRosterWarnaBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_emerald"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="Hijau"
            android:textColor="@color/emerald_800"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvRosterWaktu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Sabtu, 31 Okt 2026 • 17.00 WIB"
        android:textColor="@color/on_surface_variant"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvRosterSelebran"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Selebran: Romo Robertus Budi Prastowo, Pr"
        android:textColor="@color/secondary"
        android:textSize="11sp"
        android:textStyle="italic" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="10dp"
        android:background="@color/surface_container" />

    <!-- Subheader with count & Remind All WA button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvRosterCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Petugas Altar Terdaftar (0/12)"
            android:textColor="@color/on_surface"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Empty text -->
    <TextView
        android:id="@+id/tvRosterEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="20dp"
        android:text="Belum ada misdinar yang mendaftar tugas pada misa ini."
        android:textColor="@color/on_surface_variant"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Recycler View for Roster Members -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRosterMembers"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="8dp" />

    <!-- Close button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCloseRoster"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="14dp"
        android:text="Tutup"
        android:textColor="@color/on_surface_variant"
        app:cornerRadius="10dp" />

</LinearLayout>
