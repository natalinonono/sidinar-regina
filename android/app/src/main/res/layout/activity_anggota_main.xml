<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="40dp">

            <!-- 1. Header & Identity Section matching Web -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/surface_container"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/surface_container_lowest">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Top Action Icons Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Badges Row -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <!-- Status Badge -->
                            <TextView
                                android:id="@+id/tvStatusBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_badge_emerald"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:text="Anggota Aktif"
                                android:textColor="@color/emerald_800"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <!-- Wilayah Badge -->
                            <TextView
                                android:id="@+id/tvWilayahBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:background="@drawable/bg_badge_marian"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:text="Purbowardayan"
                                android:textColor="@color/on_primary_fixed"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Notification Bell Action -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnNotifications"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="8dp"
                            android:padding="0dp"
                            app:icon="@drawable/ic_bell"
                            app:iconTint="@color/primary"
                            app:iconGravity="textStart"
                            app:cornerRadius="10dp"
                            android:contentDescription="Notifikasi &amp; Pengingat Tugas" />

                        <!-- Riwayat Pelayanan Action matching Web /anggota/riwayat -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRiwayatTugas"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="8dp"
                            android:padding="0dp"
                            app:icon="@drawable/ic_calendar"
                            app:iconTint="@color/primary"
                            app:iconGravity="textStart"
                            app:cornerRadius="10dp"
                            android:contentDescription="Riwayat Pelayanan Altar" />

                        <!-- QR Scanner Action -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnScanQr"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:padding="0dp"
                            app:icon="@drawable/ic_qr_code"
                            app:iconTint="@color/primary"
                            app:iconGravity="textStart"
                            app:cornerRadius="10dp"
                            android:contentDescription="Presensi Sakristi" />

                        <!-- Logout Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnLogout"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="8dp"
                            android:padding="0dp"
                            app:icon="@drawable/ic_logout"
                            app:iconTint="@color/error"
                            app:iconGravity="textStart"
                            app:cornerRadius="10dp"
                            android:contentDescription="Keluar Akun" />
                    </LinearLayout>

                    <!-- Headline Greeting matching Web -->
                    <TextView
                        android:id="@+id/tvGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Berkah Dalem, Misdinar!"
                        android:textColor="@color/primary"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvJenjangWilayah"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Selamat melayani altar Tuhan dengan penuh sukacita, ketulusan doa, dan keheningan hati di Paroki SPMR Purbowardayan."
                        android:textColor="@color/on_surface_variant"
                        android:textSize="12sp"
                        android:lineSpacingExtra="2dp" />

                    <!-- Action Buttons: Edit Data Diri & Panel Pengurus -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEditProfile"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:text="Edit Data Diri"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary"
                            app:icon="@drawable/ic_person"
                            app:iconTint="@color/primary"
                            app:iconSize="16dp"
                            app:cornerRadius="10dp" />

                        <!-- Pengurus Switch Button (visible if user is pengurus) -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSwitchToPengurus"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:layout_marginStart="8dp"
                            android:text="Panel Pengurus"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/secondary"
                            app:icon="@drawable/ic_admin"
                            app:iconTint="@color/secondary"
                            app:iconSize="16dp"
                            app:cornerRadius="10dp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Pending Notice Banner if unapproved (hidden by default) -->
                    <LinearLayout
                        android:id="@+id/tvPendingNotice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_badge_amber"
                        android:gravity="center_vertical"
                        android:padding="12dp"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_admin"
                            app:tint="@color/amber_800" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="Akun Anda Dalam Tahap Verifikasi Pengurus."
                            android:textColor="@color/amber_800"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. Priority Hero: Tugas Pelayanan Altar Mendatang (matching Web exactly) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMyBooking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/primary"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- Top 4dp Gold Accent Strip -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:background="@drawable/bg_gold_accent_strip" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_marian_hero"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- Star & Badge Header -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_star"
                                app:tint="@color/secondary_fixed" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="TUGAS PELAYANAN ALTAR MENDATANG"
                                android:textColor="@color/secondary_fixed"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.05" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <!-- Status Presensi Pill -->
                            <TextView
                                android:id="@+id/tvMyBookingStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_badge_emerald"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="3dp"
                                android:text="terdaftar"
                                android:textColor="@color/emerald_800"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Title -->
                        <TextView
                            android:id="@+id/tvMyBookingTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Misa Mingguan Sabtu Sore"
                            android:textColor="@color/on_primary"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <!-- Date & Time Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_calendar"
                                app:tint="@color/secondary_fixed" />

                            <TextView
                                android:id="@+id/tvMyBookingTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="Sabtu, 31 Okt 2026 • 17.00 WIB"
                                android:textColor="#E0E7FF"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- Role chip & Calendar Quick Sync -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <!-- Petugas Altar Pill -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_segmented_selected"
                                android:backgroundTint="#26FFFFFF"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Petugas Altar"
                                    android:textColor="@color/on_primary"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <!-- Pasang Alarm Google Calendar -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnMyBookingCalendar"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="34dp"
                                android:layout_marginStart="8dp"
                                android:text="Pasang Alarm Kalender"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:textColor="@color/on_secondary_container"
                                android:backgroundTint="@color/secondary_container"
                                app:icon="@drawable/ic_notifications"
                                app:iconTint="@color/on_secondary_container"
                                app:iconSize="14dp"
                                app:cornerRadius="8dp" />
                        </LinearLayout>

                        <!-- Action Buttons: Presensi Sakristi, Ubah, Batal matching Web exactly -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:orientation="vertical">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnMyBookingCheckin"
                                style="@style/Widget.Material3.Button"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:backgroundTint="@color/secondary_container"
                                android:text="Presensi Sakristi (QR Code)"
                                android:textColor="@color/on_secondary_container"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                app:icon="@drawable/ic_qr_code"
                                app:iconTint="@color/on_secondary_container"
                                app:iconSize="18dp"
                                app:cornerRadius="12dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:orientation="horizontal">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnMyBookingEdit"
                                    style="@style/Widget.Material3.Button.TonalButton"
                                    android:layout_width="0dp"
                                    android:layout_height="42dp"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="6dp"
                                    android:text="Ubah Jadwal"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/on_primary"
                                    android:backgroundTint="#33FFFFFF"
                                    app:icon="@drawable/ic_edit"
                                    app:iconTint="@color/on_primary"
                                    app:iconSize="16dp"
                                    app:cornerRadius="10dp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnMyBookingCancel"
                                    style="@style/Widget.Material3.Button.OutlinedButton"
                                    android:layout_width="0dp"
                                    android:layout_height="42dp"
                                    android:layout_weight="1"
                                    android:layout_marginStart="6dp"
                                    android:text="Batalkan Tugas"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:textColor="#FECACA"
                                    app:strokeColor="#FECACA"
                                    app:cornerRadius="10dp" />
                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. Weekly Quota & Allocation Tracker (2 Cards Grid matching Web) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="16dp"
                android:orientation="vertical">

                <!-- Card 1: Misa Harian Tracker -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/surface_container"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@color/surface_container_lowest">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/primary_fixed">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="9dp"
                                android:src="@drawable/ic_sun"
                                app:tint="@color/primary" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Jatah Misa Harian (05.30 WIB)"
                                android:textColor="@color/on_surface"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Batas maksimal: 1x dalam sepekan"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvQuotaHarianStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_emerald"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="0 / 1 (Tersedia)"
                            android:textColor="@color/emerald_800"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card 2: Misa Mingguan Tracker -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/surface_container"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@color/surface_container_lowest">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/secondary_fixed">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="9dp"
                                android:src="@drawable/ic_church"
                                app:tint="@color/secondary" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Jatah Misa Mingguan"
                                android:textColor="@color/on_surface"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Sabtu Sore &amp; Minggu (Batas 1x / pekan)"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvQuotaMingguanStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_emerald"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="0 / 1 (Tersedia)"
                            android:textColor="@color/emerald_800"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- 4. Interactive Schedules Header & Segmented Switcher -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SIKLUS PEKAN BERJALAN"
                    android:textColor="@color/secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Pilihan Jadwal Misa &amp; Alokasi Tugas Altar"
                    android:textColor="@color/primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- Segmented Filter Switcher matching Web -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_segmented_container"
                    android:padding="3dp"
                    android:orientation="horizontal">

                    <!-- Filter: Semua Misa -->
                    <TextView
                        android:id="@+id/chipAll"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_segmented_selected"
                        android:gravity="center"
                        android:text="Semua Misa"
                        android:textColor="@color/primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- Filter: Misa Harian -->
                    <TextView
                        android:id="@+id/chipHarian"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.2"
                        android:gravity="center"
                        android:text="Misa Harian (05.30)"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="11sp"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- Filter: Misa Mingguan -->
                    <TextView
                        android:id="@+id/chipMingguan"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Misa Mingguan"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="11sp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>
            </LinearLayout>

            <!-- Loading Spinner -->
            <ProgressBar
                android:id="@+id/progressSchedules"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginVertical="24dp"
                android:visibility="gone" />

            <!-- Empty State for Schedules -->
            <TextView
                android:id="@+id/tvEmptySchedules"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="28dp"
                android:text="Tidak ada jadwal misa yang tersedia untuk kategori ini."
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- RecyclerView Schedules -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSchedules"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false" />

            <!-- 5. Announcements Section matching Web -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_announcement"
                    app:tint="@color/primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Warta &amp; Pengumuman Sakristi Paroki"
                    android:textColor="@color/primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- RecyclerView Announcements -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAnnouncements"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false" />

            <!-- Empty Announcements -->
            <TextView
                android:id="@+id/tvEmptyAnnouncements"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="20dp"
                android:text="Belum ada pengumuman terbaru di sakristi."
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- 6. WhatsApp Contacts Card matching Web -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/surface_container"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/surface_container_lowest">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kontak Bantuan &amp; Tim Pendamping"
                        android:textColor="@color/primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:layout_marginBottom="14dp"
                        android:text="Hubungi WhatsApp bila ada kendala jadwal atau perizinan tugas:"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- WA Pengurus -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnHomeContactPengurus"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:text="WA Pengurus"
                            android:textColor="@color/secondary"
                            android:textSize="11sp"
                            app:strokeColor="@color/surface_container"
                            app:icon="@drawable/ic_whatsapp"
                            app:iconTint="@color/whatsapp_green"
                            app:iconSize="16dp"
                            app:cornerRadius="10dp" />

                        <!-- WA Admin -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnHomeContactAdmin"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:text="WA Admin"
                            android:textColor="@color/primary"
                            android:textSize="11sp"
                            app:strokeColor="@color/surface_container"
                            app:icon="@drawable/ic_whatsapp"
                            app:iconTint="@color/whatsapp_green"
                            app:iconSize="16dp"
                            app:cornerRadius="10dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
